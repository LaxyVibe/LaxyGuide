{
  "name": "laxyliteguidepwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/*.test.ts",
    "test:ga": "node --experimental-strip-types --test tests/ga-config.test.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "map-bundle:usaa": "node scripts/build-map-tile-bundle.mjs JPN-USAA-TEM-001",
    "tiles:clean:usaa": "rm -rf public/maps/JPN-USAA-TEM-001",
    "tiles:gen:usaa": "gdal2tiles --xyz -p raster -r lanczos --tilesize=256 --tiledriver=WEBP --webp-quality=85 -z 0-5 src/assets/map/usaa.webp public/maps/JPN-USAA-TEM-001",
    "tiles:usaa": "npm run tiles:clean:usaa && npm run tiles:gen:usaa && npm run map-bundle:usaa"
  },
  "dependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.19.2",
    "@hugeicons/react": "^1.1.1",
    "buffer": "^6.0.3",
    "cloudinary": "^2.9.0",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.0.0",
    "googleapis": "^166.0.0",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.556.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-ga4": "^2.1.0",
    "react-helmet-async": "^2.0.5",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.6",
    "react-zoom-pan-pinch": "^3.7.0",
    "vite-plugin-pwa": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
