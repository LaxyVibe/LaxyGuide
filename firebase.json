{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "timeout": "540s"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/process-pdf",
        "function": "processPdfVertex"
      },
      {
        "source": "!(laxy-admin){,/**}",
        "destination": "/index.html"
      }
    ]
  }
}
